{
  "name": "x-sentinel",
  "version": "1.3.5",
  "description": "Autonomous Multi-Node Fleet Cockpit & Growth Studio for X",
  "main": "worker/bot_worker.js",
  "scripts": {
    "client:dev": "bun run --cwd client dev",
    "client:build": "bun run --cwd client build",
    "build": "bun run --cwd client build",
    "lint": "eslint worker server test eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node test/verify.js && node test/test_rate_governor.js && node test/test_phase2.js && node test/test_phase3_phase4.js && node test/test_phase5.js && node test/test_warmup_toggle.js",
    "postinstall": "node server/automation/bot/patchPlaywright.js"
  },
  "keywords": [
    "x",
    "twitter",
    "automation",
    "playwright",
    "cockpit",
    "scheduler"
  ],
  "author": "MHendriF",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "camoufox": "^0.1.19",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
