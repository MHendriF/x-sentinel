{
  "name": "x-sentinel",
  "version": "1.3.1",
  "description": "Autonomous Multi-Node Fleet Cockpit & Growth Studio for X",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "client:dev": "bun run --cwd client dev",
    "client:build": "bun run --cwd client build",
    "build": "bun run --cwd client build",
    "lint": "eslint server test eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node test/verify.js",
    "smoke": "node test/smoke_api.js"
  },
  "keywords": [
    "x",
    "twitter",
    "automation",
    "playwright",
    "cockpit",
    "scheduler"
  ],
  "author": "MHendriF",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "playwright": "^1.62.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
